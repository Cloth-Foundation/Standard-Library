sealed class: Integer {
  static final uint16 MIN_VALUE = 0u16;
  static final uint16 MAX_VALUE = 65535u16;
  static final int32 BYTES = 2;
  static final int32 BITS = 16;

  final uint16 value;

  UInt16 (uint16 value): Integer() {
    self.value = value;
  }

  override func Equals (Object? other): bool {
    return __valueBoxEquals(self, other);
  }

  override func HashCode (): uint64 {
    return __valueBoxHashCode(self);
  }

  override func ToString (): string {
    return __valueBoxToString(self);
  }
}
